{
  "name": "@untilov/code-rag",
  "version": "0.1.0",
  "description": "Universal CodeUnit-based RAG system with MCP integration",
  "type": "module",
  "license": "MIT",
  "author": "serhii-untilov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhii-untilov/code-rag.git"
  },
  "main": "dist/index.js",
  "bin": {
    "code-rag": "dist/cli/index.js"
  },
  "keywords": [
    "rag",
    "code-search",
    "retrieval-augmented-generation",
    "vector-search",
    "embeddings",
    "semantic-search",
