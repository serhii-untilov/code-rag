    "ts-morph": "^25.0.1",
    "uuid": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
